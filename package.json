{
  "name": "werk",
  "productName": "werk",
  "version": "0.1.0",
  "private": true,
  "description": "Local job discovery, fit assessment, cover letters and CV management.",
  "author": "John Goh",
  "license": "MIT",
  "type": "module",
  "main": "out/main.cjs",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "package": "node scripts/package.mjs",
    "smoke": "node --experimental-strip-types tests/smoke.ts"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.104.4",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.1",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "zod": "4.6.6"
  },
  "build": {
    "appId": "io.github.rengwu.werk",
    "productName": "werk",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      },
      {
        "from": "resources/tray@2x.png",
        "to": "tray@2x.png"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "werk-${version}-setup.${ext}"
    },
    "dmg": {
      "artifactName": "werk-${version}-arm64.${ext}"
    }
  }
}
