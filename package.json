{
  "name": "werk",
  "productName": "werk",
  "version": "0.1.1",
  "private": true,
  "description": "Local job discovery, fit assessment, cover letters and CV management.",
  "author": "John Goh",
  "license": "MIT",
  "type": "module",
  "main": "out/main.cjs",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "package": "node scripts/package.mjs",
    "smoke": "node --experimental-strip-types tests/smoke.ts",
    "setup:latex": "node --experimental-strip-types scripts/setup-latex.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@codemirror/commands": "6.8.1",
    "@codemirror/language": "6.11.3",
    "@codemirror/legacy-modes": "6.5.1",
    "@codemirror/state": "6.5.4",
    "@codemirror/view": "6.38.6",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-query": "5.104.4",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "6.1.2",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "electron": "44.9.1",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "pdfjs-dist": "5.4.624",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sanitize-html": "2.18.1",
    "typescript": "5.9.3",
    "undici": "7.30.1",
    "vite": "8.3.4",
    "zod": "4.6.6"
  },
  "build": {
    "appId": "io.github.rengwu.werk",
    "productName": "werk",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      },
      {
        "from": "resources/tray@2x.png",
        "to": "tray@2x.png"
      },
      {
        "from": "resources/geography",
        "to": "geography"
      },
      {
        "from": "resources/latex",
        "to": "latex"
      },
      {
        "from": "resources/runtime",
        "to": "runtime"
      },
      {
        "from": "resources/licenses",
        "to": "licenses"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "signIgnore": [
        "/Contents/Resources/runtime/cache/"
      ],
      "identity": "-",
      "icon": "resources/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "werk-${version}-setup.${ext}"
    },
    "dmg": {
      "artifactName": "werk-${version}-arm64.${ext}"
    }
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.2",
      "minimatch": "11.0.1"
    }
  }
}
